# ══════════════════════════════════════════════════════════════════════════════
# Sovereign Agent Lab — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# SETUP
# -----
# 1. Copy:   cp .env.example .env
# 2. Fill in required keys
# 3. Never commit .env (already ignored in .gitignore)
#
# RULES
# -----
# - No quotes around values
# - No spaces around '='
# - Do not delete unused keys (leave placeholders)
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
# CORE LLM PROVIDER (Required for all agents)
# ──────────────────────────────────────────────────────────────────────────────

NEBIUS_KEY=sk-your-key-here
# Primary API key used for:
# - Llama 3.3 70B (agent reasoning)
# - Embeddings models
# - Image generation (FLUX)


# ──────────────────────────────────────────────────────────────────────────────
# RASA PRO CALM (Conversation Agent)
# ──────────────────────────────────────────────────────────────────────────────

RASA_PRO_LICENSE=your-rasa-pro-license-key-here
# Required for running CALM-based conversation agent locally.
# Free developer license available from Rasa.


# ──────────────────────────────────────────────────────────────────────────────
# WEEK 2 — WEB SEARCH TOOLING (Optional)
# ──────────────────────────────────────────────────────────────────────────────

TAVILY_API_KEY=tvly-your-key-here
# Enables web search for research agent (Week 2+)


# ──────────────────────────────────────────────────────────────────────────────
# WEEK 4 — RAG / MEMORY LAYER (Optional)
# ──────────────────────────────────────────────────────────────────────────────

PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX_NAME=sovereign-agent
# Vector database for long-term memory / retrieval systems


# ──────────────────────────────────────────────────────────────────────────────
# WEEK 5 — OBSERVABILITY (Optional)
# ──────────────────────────────────────────────────────────────────────────────

LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=sovereign-agent-lab
LANGCHAIN_TRACING_V2=false
# Enables tracing and debugging for LangGraph agents


# ──────────────────────────────────────────────────────────────────────────────
# TRACK B — VOICE PIPELINE (Optional)
# ──────────────────────────────────────────────────────────────────────────────

SPEECHMATICS_API_KEY=your-speechmatics-key-here
# Speech-to-text + text-to-speech pipeline (voice assistant mode)